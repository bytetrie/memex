# Apply edits with: sudo devstack-sync reload caddy (after the isolation phase).
# Snippets and site blocks only: the global options are in /etc/caddy/Caddyfile, which
# imports this file, and a global block here would stop Caddy from loading it.

(common) {
	header -Server
	header -Via
}

(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; style-src 'self' 'sha256-yxI2BMznRoEWTLo0ziggIKtFM2CcPAwgOzAk/GeDlUM='; worker-src 'self' blob:; script-src 'self'; img-src 'self' data:; frame-src 'self'; connect-src 'self'; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; media-src blob: 'self'; object-src 'none'; upgrade-insecure-requests;"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
	}
}

(error_page) {
  # Never cache an error (overrides the immutable header on /assets/*).
  header Cache-Control "no-store"
	root * /srv/proj/error
	rewrite * /index.html
	file_server {
		precompressed br gzip
	}
}

app.memex {
	import common
	import security_headers
	import devstack_same_origin
	# The largest archive file (MAX_FILE_BYTES in src/shared/archive-types.ts; keep them equal).
	request_body {
		max_size 4GiB
	}
	encode zstd gzip
	root * /srv/proj/static
	reverse_proxy /api/* 127.0.0.1:8080 {
		header_up X-Internal-Token {env.INTERNAL_TOKEN}

		# Don't leak an internal credential failure.
		@upstream_internal_error status 500
		handle_response @upstream_internal_error {
			respond 500
		}
	}
	handle_errors {
		import error_page
	}
  # Vite's hashed bundles never change: cache them for good. Missing ones 404.
  @assets path /assets/*
  header @assets Cache-Control "public, max-age=31536000, immutable"
  # Client-side routes (TanStack Router): any path that is not a file, an
  # asset or the API serves index.html. Always revalidate those responses so
  # a new build's asset hashes are picked up.
  @spa {
          not path /api/* /assets/* /fonts/*
          not file
  }
  rewrite @spa /index.html
  @html path / /index.html
  header @spa Cache-Control "no-cache"
  header @html Cache-Control "no-cache"
	file_server {
		precompressed br gzip
	}
}

http:// {
	import common
	import security_headers
	import devstack_same_origin
	import error_page
}
