# GENERATED by devstack (stack memex) from templates/system/app.service.
# Change devstack.toml / the template and re-run `devstack up --redo isolation`.
# Hardened: fixed system user, read-only system, writable app data only, and an
# nftables egress profile ("local") enforced by the kernel.
# Check the exposure with:
#   systemd-analyze security memex-app
[Unit]
Description=memex app (127.0.0.1:8080)
After=network.target postgresql.service devstack-egress.service
# No egress rules, no app: if the profile can't load, the service doesn't start.
Requires=devstack-egress.service

[Service]
ExecStart=/usr/local/bin/node /srv/proj/server.ts
WorkingDirectory=/srv/proj
Environment=NODE_ENV=production APP_BIND=127.0.0.1 APP_PORT=8080
# Caddy -> app shared secret (required)
EnvironmentFile=/etc/app-secrets/internal-token.env
# Postgres credentials (optional: only exists after the postgres phase)
EnvironmentFile=-/etc/app-secrets/postgres.env

# Fixed uid (not DynamicUser): the egress profile and file ownership on the
# persistent data volume both need a uid that never changes.
User=memex-app
Group=memex-data
NoNewPrivileges=yes

# Filesystem: read-only everywhere it's allowed to see. The only writable path
# is the app data folder below ($STATE_DIRECTORY), if app.data is enabled.
# The project lives under /srv (not /home), so ProtectHome=yes is safe here.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/srv/proj
# App data: /var/lib/memex-app (persistent; $STATE_DIRECTORY). o+x so runners can reach incoming/;
# files below it are 0640 and folders 2750 (UMask), so nobody else can read them.
StateDirectory=memex-app
StateDirectoryMode=2751
# New files: owner rw, group (memex-data: the dev user) read, others nothing.
UMask=0027

# No process visibility into the rest of the system
ProtectProc=invisible
ProcSubset=pid

# Kernel/device/cgroup hardening
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
# Not MemoryDenyWriteExecute=yes: V8's JIT needs W+X pages.

# Capabilities: none needed (high port, non-root)
CapabilityBoundingSet=
AmbientCapabilities=

# Network: what this service may reach is the egress profile "local" in
# /etc/devstack/egress.nft (nftables, matched on this unit's uid), not a setting
# here. systemd's IPAddressDeny= is not used: unprivileged containers can't attach
# the cgroup filter it needs, and systemd then starts the unit without it.
# The rest of the container (ssh sessions, builds, agents) is not covered by it.
# No AF_UNIX: Postgres is reached over TCP 127.0.0.1, not its socket.
RestrictAddressFamilies=AF_INET AF_INET6

# Syscalls: standard service allow-list
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
