{
  "name": "memex",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.ts",
    "build": "vite build && ./infra/compress-static.sh static",
    "dev": "vite build --watch --mode development",
    "dev:hmr": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "eslint --max-warnings 0 .",
    "lint:changed": "scripts/lint-changed.sh",
    "check": "pnpm typecheck && pnpm lint",
    "check:csp": "node scripts/check-csp.ts",
    "icons": "node scripts/build-icons.ts",
    "fonts": "./scripts/build-fonts.sh",
    "test:e2e": "playwright test",
    "sync-env": "./scripts/sync-env.sh",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=$HOME/.config/devstack/memex.env scripts/migrate.ts",
    "archive": "node scripts/archive.ts",
    "yt-dlp": "node scripts/yt-dlp.ts"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-router": "^1.170.41",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "hls.js": "1.7.3",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "hono-openapi": "^1.3.3",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  }
}
